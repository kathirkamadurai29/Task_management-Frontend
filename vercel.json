{
  "rewrites": [
    {
      "source": "/auth/:match*",
      "destination": "https://taskflow-api.onrender.com/auth/:match*"
    },
    {
      "source": "/tasks/:match*",
      "destination": "https://taskflow-api.onrender.com/tasks/:match*"
    },
    {
      "source": "/dashboard/:match*",
      "destination": "https://taskflow-api.onrender.com/dashboard/:match*"
    },
    {
      "source": "/health",
      "destination": "https://taskflow-api.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
